{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "functions": {
    "src/app/api/queues/collect-hotel/route.ts": {
      "maxDuration": 1800,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "hotel-collection",
          "maxConcurrency": 2,
          "retryAfterSeconds": 30
        }
      ]
    }
  },
  "crons": [{ "path": "/api/cron/collect", "schedule": "0 5 * * 1" }]
}
