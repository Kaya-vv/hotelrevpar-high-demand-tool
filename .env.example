NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
TICKETMASTER_API_KEY=
FOOTBALLDATA_API_KEY=
PREDICTHQ_ACCESS_TOKEN=
# Research runs on OpenAI gpt-6-luna. RESEARCH_PROVIDER=sonnet switches back to Anthropic (rollback only).
OPENAI_API_KEY=
RESEARCH_PROVIDER=luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_DISCOVERY_MODEL=
ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5-20251001
CRON_SECRET=
EVENT_NOTIFICATIONS_ENABLED=disabled
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
# Local rollout test only. Do not add these two values to Vercel.
RESEND_TEST_EMAIL=
NOTIFICATION_TEST_HOTEL_ID=
 # Experimental long-range collection stays disabled until benchmark acceptance.
LONG_RANGE_DISCOVERY=disabled
# Enable only after the offline/live gates; empty preserves the existing market scope.
LONG_RANGE_MARKETS=Eindhoven,Rotterdam,Groningen,Amsterdam
# Plug&Pay sells the subscription. Token and webhook key: Plug&Pay > Settings > Developers.
PLUGANDPAY_API_TOKEN=
PLUGANDPAY_WEBHOOK_KEY=
# Numeric product ids that grant hotels, comma separated. Other products are ignored.
PLUGANDPAY_HOTEL_PRODUCT_IDS=
# Set to enabled only while testing; it lets Plug&Pay test-mode orders create real accounts.
PLUGANDPAY_TEST_MODE=disabled
